---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pilares } from '../../data/pilares';
import { breadcrumbList, articulo, faqPage } from '../../lib/seo';

export async function getStaticPaths() {
  const entradas = await getCollection('averias', ({ data }) => !data.draft);
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);

const pilar = pilares.averias;
const site = Astro.site!;
const urlArticulo = new URL(`/${pilar.slug}/${entrada.id}/`, site).toString();

const migas = [
  { nombre: 'Inicio', url: new URL('/', site).toString() },
  { nombre: pilar.nombre, url: new URL(`/${pilar.slug}/`, site).toString() },
  { nombre: entrada.data.title, url: urlArticulo },
];

const bloquesJsonLd: unknown[] = [
  breadcrumbList(migas),
  articulo({
    titulo: entrada.data.title,
    descripcion: entrada.data.description,
    url: urlArticulo,
    fechaPublicacion: entrada.data.pubDate.toISOString(),
    fechaModificacion: entrada.data.updatedDate?.toISOString(),
  }),
];
if (entrada.data.faq && entrada.data.faq.length > 0) {
  bloquesJsonLd.push(faqPage(entrada.data.faq));
}

const title = `${entrada.data.title} | Mundo Astra H`;
---

<BaseLayout title={title} description={entrada.data.description} seccion="averias">
  <Fragment slot="head">
    {
      bloquesJsonLd.map((bloque) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(bloque)} />
      ))
    }
  </Fragment>

  <nav aria-label="Migas de pan">
    <ol class="crumbs">
      <li><a href="/">Inicio</a></li>
      <li><span class="sep">/</span><a href={`/${pilar.slug}/`}>{pilar.nombre}</a></li>
      <li><span class="sep">/</span><span aria-current="page">{entrada.data.title}</span></li>
    </ol>
  </nav>

  <article>
    <h1 class="titulo-pagina">{entrada.data.title}</h1>

    <div class="ficha">
      <div class="ficha__celda">
        <p class="ficha__k">Sistema afectado</p>
        <p class="ficha__v">{entrada.data.sistemaAfectado}</p>
      </div>
      {
        entrada.data.motoresAfectados && (
          <div class="ficha__celda">
            <p class="ficha__k">Motores afectados</p>
            <p class="ficha__v">{entrada.data.motoresAfectados.join(' · ')}</p>
          </div>
        )
      }
      <div class="ficha__celda">
        <p class="ficha__k">Kilometraje y coste</p>
        <p class="ficha__v">{entrada.data.kilometrajeYCoste}</p>
      </div>
    </div>

    <div class="prosa">
      <Content />
    </div>

    {
      entrada.data.faq && entrada.data.faq.length > 0 && (
        <section class="faq">
          <h2>Preguntas frecuentes</h2>
          {entrada.data.faq.map((f) => (
            <div class="faq__item">
              <h3>{f.pregunta}</h3>
              <p>{f.respuesta}</p>
            </div>
          ))}
        </section>
      )
    }
  </article>
</BaseLayout>

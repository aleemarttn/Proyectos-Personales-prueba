---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PilarIndice from '../../components/PilarIndice.astro';
import { pilares } from '../../data/pilares';
import { breadcrumbList } from '../../lib/seo';

const pilar = pilares.motorizaciones;
const site = Astro.site!;

const articulos = (await getCollection('motorizaciones', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((a) => ({ id: a.id, title: a.data.title }));

const breadcrumbLd = breadcrumbList([
  { nombre: 'Inicio', url: new URL('/', site).toString() },
  { nombre: pilar.nombre, url: new URL(`/${pilar.slug}/`, site).toString() },
]);

const title = `${pilar.nombre} del Opel Astra H: análisis por motor | Mundo Astra H`;
---

<BaseLayout title={title} description={pilar.descripcionSeo} seccion="motorizaciones">
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  <PilarIndice pilar={pilar} articulos={articulos} />
</BaseLayout>

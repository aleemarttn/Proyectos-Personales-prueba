---
import '../styles/global.css';
import { pilares, ordenPilares } from '../data/pilares';

interface Props {
  title: string;
  description: string;
  /** Clave del pilar activo (para resaltar el menú). Opcional. */
  seccion?: string;
}

const { title, description, seccion } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const anyo = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">AH</span>
          Mundo Astra H
        </a>
        <nav class="site-nav" aria-label="Secciones">
          {
            ordenPilares.map((clave) => {
              const p = pilares[clave];
              return (
                <a
                  href={`/${p.slug}/`}
                  aria-current={seccion === clave ? 'page' : undefined}
                >
                  {p.nombre}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Mundo Astra H · Guías técnicas del Opel Astra H (2004–2010)</span>
        <span>© {anyo}</span>
      </div>
    </footer>
  </body>
</html>
